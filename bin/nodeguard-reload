#!/bin/bash
# nodeguard-reload: hitless object update.
# SAFETY: loads the new object as an additional dispatcher member against
# the same pin root, verifies map identity, and only then unloads the OLD
# program by id - the old member keeps enforcing until the new one is
# confirmed good.
# systemctl restart nodeguard-xdp is a full detach/reattach (ixgbe link
# blips) and is the wrong tool for deploying a patched object.
set -uo pipefail
. /usr/local/lib/nodeguard/nodeguard-lib.sh
ng_env

new_obj="${1:-$NG_OBJ}"
[ -f "$new_obj" ] || { echo "no such object: $new_obj" >&2; exit 2; }

old_ids=$(ng_prog_ids | tr '\n' ' ')
if [ -z "$old_ids" ]; then
    echo "nodeguard is not attached on $IFACE; use systemctl start nodeguard-xdp" >&2
    exit 2
fi

if ! ng_spec_pins_present; then
    ng_log "reload refused: spec-listed pins missing; old program keeps enforcing" err
    exit 1
fi

if ! xdp-loader load -m native -p "$NG_PIN" "$IFACE" "$new_obj"; then
    ng_log "reload: load of $new_obj failed; old program still enforcing" err
    exit 1
fi

new_id=""
extra=0
for id in $(ng_prog_ids); do
    case " $old_ids " in
    *" $id "*) ;;
    *)
        if [ -n "$new_id" ]; then extra=1; fi
        new_id="$id"
        ;;
    esac
done
if [ -z "$new_id" ]; then
    ng_log "reload: could not identify the new program id; manual inspection required" err
    exit 1
fi
if [ "$extra" -eq 1 ]; then
    ng_log "reload: dispatcher holds more than one unexpected nodeguard member; aborting and unloading the just-loaded program" err
    xdp-loader unload "$IFACE" -i "$new_id"
    exit 1
fi

if ! ng_verify_map_identity "$new_id"; then
    ng_log "reload: identity check failed for prog $new_id; unloading it, old program keeps enforcing" err
    xdp-loader unload "$IFACE" -i "$new_id"
    exit 1
fi

for id in $old_ids; do
    xdp-loader unload "$IFACE" -i "$id"
done
echo "$new_id" > "$NG_RUN/prog_id"
echo "$new_id" > "$NG_RUN/expected_prog_id"
if [ "$new_obj" != "$NG_OBJ" ]; then
    install -m 0644 "$new_obj" "$NG_OBJ"
    restorecon "$NG_OBJ" 2>/dev/null || true
fi
ng_log "reload: swapped to prog id $new_id (old: $old_ids); map identity verified"
