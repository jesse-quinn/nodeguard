#!/bin/bash
# nodeguard-watchdog: one cycle, run every minute by nodeguard-watchdog.timer.
# SAFETY: lifeline probes (allowlisted paths) detect datapath death; the
# canary probe (a deliberately NON-allowlisted TCP/443 target) detects
# over-blocking.
# Latch semantics per docs/design.md.
set -uo pipefail
. /usr/local/lib/nodeguard/nodeguard-lib.sh
ng_env
mkdir -p "$NG_RUN"

# Export the status snapshot for the monitoring agent. SELinux keeps
# zabbix_agent_t from making bpf() syscalls (sudo does not change the
# domain), so the agent reads this file instead of running the tools.
if [ -d /run/zabbix ]; then
    /usr/local/sbin/nodeguard-status --kv > /run/zabbix/nodeguard.kv.tmp 2>/dev/null         && chmod 0644 /run/zabbix/nodeguard.kv.tmp         && mv -f /run/zabbix/nodeguard.kv.tmp /run/zabbix/nodeguard.kv || true
fi

# Nothing to guard before the maps exist.
[ -e "$NG_PIN/config" ] || exit 0

counter() { cat "$NG_RUN/wd_$1" 2>/dev/null || echo 0; }
set_counter() { echo "$2" > "$NG_RUN/wd_$1"; }

latched_by() {
    if [ -f "$NG_RUN/manual_off" ]; then echo manual; else echo watchdog; fi
}

remind_hourly() {
    local msg="$1" last now
    last=$(cat "$NG_RUN/wd_last_remind" 2>/dev/null || echo 0)
    now=$(date +%s)
    if [ $(( now - last )) -ge 3600 ]; then
        ng_log "$msg" crit
        echo "$now" > "$NG_RUN/wd_last_remind"
    fi
}

# SAFETY: soft-off that never lies - if the kill-switch write fails,
# escalate straight to the fail-open action the soft-off could not
# deliver.
soft_off_or_detach() {
    local why="$1"
    if /usr/local/sbin/nodeguard-off --watchdog; then
        ng_log "watchdog: $why; enforcement soft-off" crit
    else
        ng_log "watchdog: $why; soft-off FAILED, detaching XDP instead" crit
        systemctl stop nodeguard-xdp.service
    fi
}

# --- port refresh (every cycle, attach state irrelevant) ---
live_port=$(ng_live_wg_port)
cfg_port=$(ng_cfg_get 0 2>/dev/null || echo "")
if [ -n "$live_port" ] && [ -n "$cfg_port" ] && [ "$live_port" != "$cfg_port" ]; then
    ng_cfg_set 0 "$live_port"
    ng_log "watchdog: wg port moved $cfg_port -> $live_port; config[0] rewritten" warning
fi

# --- probes ---
probe_gw() {
    local gw
    gw=$(ip -4 route show default 2>/dev/null | awk '{print $3; exit}')
    [ -n "$gw" ] && ping -c1 -W2 "$gw" >/dev/null 2>&1
}
probe_dns() {
    python3 - <<'PYEOF' >/dev/null 2>&1
import socket, struct, sys
q = struct.pack(">HHHHHH", 0x1234, 0x0100, 1, 0, 0, 0)
for part in b"quad9", b"net":
    q += bytes([len(part)]) + part
q += b"\x00" + struct.pack(">HH", 1, 1)
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.settimeout(3)
s.sendto(q, ("9.9.9.9", 53))
data, _ = s.recvfrom(512)
sys.exit(0 if len(data) > 12 else 1)
PYEOF
}
probe_tailscale() {
    tailscale status --json 2>/dev/null | python3 -c '
import json, sys
d = json.load(sys.stdin)
sys.exit(0 if d.get("Self", {}).get("Online") else 1)
' 2>/dev/null
}
probe_officegw() {
    # SAFETY: fails when OFFICE_GW is unset - the conservative,
    # fail-open-blocking direction (a misconfigured host never auto
    # re-arms).
    [ -n "${OFFICE_GW:-}" ] && ping -c1 -W2 "$OFFICE_GW" >/dev/null 2>&1
}
probe_canary() {
    python3 - "$CANARY_IP" "${CANARY_PORT:-443}" <<'PYEOF' >/dev/null 2>&1
import socket, sys
s = socket.create_connection((sys.argv[1], int(sys.argv[2])), timeout=5)
s.close()
PYEOF
}

lifeline_ok=0
lifeline_all_fail=1
lifeline_all_ok=1
for probe in ${LIFELINES:?LIFELINES not set}; do
    if "probe_$probe"; then
        lifeline_ok=1
        lifeline_all_fail=0
    else
        lifeline_all_ok=0
    fi
done

canary_ok=0
probe_canary && canary_ok=1

ks=$(ng_cfg_get 1)

# --- attach state: three-valued (attached / detached / unknown) ---
ids=$(ng_prog_ids)
rc=$?
if [ "$rc" -ne 0 ]; then
    attach_state=unknown
elif [ -n "$ids" ]; then
    attach_state=attached
else
    attach_state=detached
fi

if [ "$attach_state" = "detached" ]; then
    set_counter canary_fail 0
    set_counter lifeline_fail 0
    set_counter clean 0
    # INVARIANT: a latch with the datapath already detached still
    # deserves its hourly reminder; auto re-arm stays out of this branch
    # (re-arming config[1] while detached would silently arm the next
    # attach). The re-arm check further down depends on these counters
    # and on config[2] being left untouched here.
    if [ "$ks" != "0" ]; then
        remind_hourly "watchdog: enforcement is OFF and XDP is DETACHED (latched: $(latched_by)); systemctl start nodeguard-xdp then nodeguard-on to recover"
    fi
    exit 0
fi
if [ "$attach_state" = "unknown" ]; then
    # SAFETY: xdp-loader itself failed; the program may still be
    # enforcing, and nodeguard-off works through the pinned maps
    # regardless. Fall through with counters live: a spurious soft-off
    # fails open and loud.
    set_counter toolfail $(( $(counter toolfail) + 1 ))
    lvl=err
    [ "$(counter toolfail)" -ge 3 ] && lvl=crit
    ng_log "watchdog: attach state UNKNOWN (xdp-loader status failed); assuming still attached ($(counter toolfail) consecutive)" "$lvl"
else
    set_counter toolfail 0
fi

# --- counters ---
if [ "$canary_ok" -eq 1 ]; then
    set_counter canary_fail 0
else
    set_counter canary_fail $(( $(counter canary_fail) + 1 ))
fi
if [ "$lifeline_all_fail" -eq 1 ]; then
    set_counter lifeline_fail $(( $(counter lifeline_fail) + 1 ))
else
    set_counter lifeline_fail 0
fi
if [ "$canary_ok" -eq 1 ] && [ "$lifeline_all_ok" -eq 1 ]; then
    set_counter clean $(( $(counter clean) + 1 ))
else
    set_counter clean 0
fi

# --- actions ---
if [ "$ks" = "0" ]; then
    if [ "$(counter canary_fail)" -ge 3 ] && [ "$lifeline_ok" -eq 1 ]; then
        drops=$(python3 "$NG_MAP" stats --json 2>/dev/null || echo '{}')
        soft_off_or_detach "OVER-BLOCK suspected (canary $CANARY_IP:${CANARY_PORT:-443} failed 3 cycles, lifelines fine); stats: $drops"
    elif [ "$(counter lifeline_fail)" -ge 5 ]; then
        soft_off_or_detach "all lifelines failing 5 cycles (may be an upstream outage)"
        set_counter lifeline_fail 0
    fi
else
    # Latched.
    if [ "$(counter lifeline_fail)" -ge 10 ]; then
        ng_log "watchdog: lifelines still dead 10 cycles after soft-off; detaching XDP" crit
        systemctl stop nodeguard-xdp.service
        # Verify the dispatcher actually shed the member; systemctl stop
        # is a no-op when the unit was not active.
        remaining=$(ng_prog_ids) || remaining="UNKNOWN"
        if [ -n "$remaining" ] && [ "$remaining" != "UNKNOWN" ]; then
            /usr/local/sbin/nodeguard-detach
            remaining=$(ng_prog_ids) || remaining="UNKNOWN"
        fi
        if [ -z "$remaining" ]; then
            set_counter lifeline_fail 0
        else
            ng_log "watchdog: detach INCOMPLETE, dispatcher still holds: $remaining (manual: xdp-loader unload $IFACE -i <id>)" crit
            # Counter left >= 10 so the detach retries every cycle.
        fi
    fi
    # SAFETY: bounded auto re-arm - watchdog-set latches only, once per
    # boot.
    if [ -f "$NG_RUN/watchdog_off" ] && [ ! -f "$NG_RUN/manual_off" ] \
        && [ "$(counter clean)" -ge 15 ] && [ "$(ng_cfg_get 2)" = "0" ]; then
        if /usr/local/sbin/nodeguard-on; then
            ng_cfg_set 2 1
            ng_log "watchdog: auto re-arm after 15 clean cycles (once per boot); enforcement back ON" crit
        fi
    fi
    remind_hourly "watchdog: enforcement is OFF (latched: $(latched_by)); nodeguard-on to re-arm"
fi
exit 0
