#!/bin/bash
# nodeguard-attach: load nodeguard into the libxdp dispatcher on $IFACE in
# native mode, then verify the attached program uses the pinned maps.
# ExecStart of nodeguard-xdp.service. Fails loudly; never falls back to skb.
set -uo pipefail
. /usr/local/lib/nodeguard/nodeguard-lib.sh
ng_env
mkdir -p "$NG_RUN"

# Every pre-existing member must pass the map-identity check; a member
# enforcing orphaned maps is unloaded, never blessed.
existing=$(ng_prog_ids) || existing=""
verified=""
for id in $existing; do
    if ng_verify_map_identity "$id"; then
        verified="$id"
    else
        ng_log "attached prog $id enforces orphaned maps; unloading it" crit
        if ! xdp-loader unload "$IFACE" -i "$id"; then
            ng_log "cleanup unload of prog $id FAILED; manual xdp-loader unload $IFACE -i $id required" crit
            exit 1
        fi
    fi
done
if [ -n "$verified" ]; then
    echo "$verified" > "$NG_RUN/prog_id"
    ng_log "nodeguard already attached on $IFACE (prog id $verified), map identity verified"
    exit 0
fi

if ! xdp-loader load -m native -p "$NG_PIN" "$IFACE" "$NG_OBJ"; then
    ng_log "native XDP attach FAILED on $IFACE; host runs OPEN (no fallback by design)" crit
    exit 1
fi

prog_id=$(ng_prog_ids | head -1)
if [ -z "$prog_id" ]; then
    ng_log "attach reported success but nodeguard not in dispatcher on $IFACE" crit
    exit 1
fi

# Map identity check: a divergence means the program is enforcing against
# maps nobody manages: unload and fail.
if ! ng_verify_map_identity "$prog_id"; then
    if ! xdp-loader unload "$IFACE" -i "$prog_id"; then
        ng_log "cleanup unload of prog $prog_id FAILED after identity mismatch; manual unload required" crit
    fi
    ng_log "map identity check failed; nodeguard unloaded, host runs OPEN" crit
    exit 1
fi

echo "$prog_id" > "$NG_RUN/prog_id"
ng_log "nodeguard attached on $IFACE, prog id $prog_id, map identity verified"
exit 0
