# Interface the XDP program attaches to (physical NIC, never a bridge/bond
# member; see docs/design.md).
IFACE=eth0
# The watchdog's over-blocking canary: a TCP/443 target that must NEVER
# appear in any allow file.
CANARY_IP=1.1.1.1
CANARY_PORT=443
# Lifeline probes: gw dns tailscale officegw (see bin/nodeguard-watchdog)
LIFELINES="gw dns"
# yes on a DHCP WAN gateway: allowlists the live default gateway, DHCP
# server, and own WAN /32 at every maps start.
WAN_DYNAMIC_ALLOW=yes
