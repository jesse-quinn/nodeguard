# INVARIANT: interface the XDP program attaches to must be a physical
# NIC, never a bridge/bond member; see docs/design.md.
IFACE=eth0
# INVARIANT: the watchdog's over-blocking canary - CANARY_IP must NEVER
# appear in any allow file (checked by ngmap.py reconcile-allow and
# nodeguard-maps step 4); doing so would blind the over-block probe.
CANARY_IP=1.1.1.1
CANARY_PORT=443
# INVARIANT: lifeline probe names here must match a probe_<name> function
# in bin/nodeguard-watchdog: gw dns tailscale officegw.
LIFELINES="gw dns"
# yes on a DHCP WAN gateway: allowlists the live default gateway, DHCP
# server, and own WAN /32 at every maps start.
WAN_DYNAMIC_ALLOW=yes
# Volumetric anomaly detector (ADR 0007): off | shadow | on. Shadow logs
# and counts ng.anomaly_shadow_count without paging. K and FLOOR are
# retuned from shadow data before mode on; record the date when changed.
WD_ANOM_MODE=shadow
WD_ANOM_K=8
WD_ANOM_FLOOR=500
WD_ANOM_TRIP=3
WD_ANOM_ADAPT=30
